{
  "datasets": [
    {
      "name": "6291f5ed",
      "displayName": "Customer_most_spent",
      "queryLines": [
        "SELECT customer_id, SUM(total_spent) AS sum_total_spent\r\n",
        "FROM catalog_tr.golden.customer_summary\r\n",
        "GROUP BY customer_id\r\n",
        "ORDER BY sum_total_spent DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "d92f5679",
      "displayName": "transactions_by_payment_method",
      "queryLines": [
        "SELECT store_location, payment_method, transactions\r\n",
        "FROM catalog_tr.golden.payment_method_by_store\r\n",
        "ORDER BY store_location, transactions DESC;"
      ]
    },
    {
      "name": "22e788b5",
      "displayName": "top_products_sold",
      "queryLines": [
        "SELECT product_id, product_name, units_sold\r\n",
        "FROM catalog_tr.golden.product_performance\r\n",
        "ORDER BY transactions DESC\r\n",
        "LIMIT 5;"
      ]
    },
    {
      "name": "0a4660ba",
      "displayName": "top_transactions_hour_day",
      "queryLines": [
        "SELECT day_of_week, transactions, transaction_hour\r\n",
        "FROM catalog_tr.golden.sales_by_weekday_hour\r\n",
        "ORDER BY transactions DESC, transaction_hour\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "3ee2af54",
      "displayName": "Daily Sales Overview from Catalog Tr",
      "queryLines": [
        "select * from catalog_tr.golden.sales_daily limit 10"
      ]
    },
    {
      "name": "fact_sales_mv",
      "displayName": "Ventas detalle (fact_sales)",
      "config": {
        "version": "1.1",
        "source": "catalog_tr.golden.fact_sales",
        "dimensions": [
          {
            "expr": "transaction_day"
          },
          {
            "expr": "transaction_week"
          },
          {
            "expr": "transaction_hour"
          },
          {
            "expr": "day_of_week"
          },
          {
            "expr": "store_location"
          },
          {
            "expr": "category"
          },
          {
            "expr": "payment_method"
          },
          {
            "expr": "product_id"
          }
        ],
        "measures": [
          {
            "name": "revenue",
            "expr": "SUM(total_amount)"
          },
          {
            "name": "transactions",
            "expr": "COUNT(DISTINCT transaction_id)"
          },
          {
            "name": "units_sold",
            "expr": "SUM(quantity)"
          },
          {
            "name": "unique_customers",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "avg_ticket",
            "expr": "SUM(total_amount) / COUNT(DISTINCT transaction_id)"
          }
        ]
      }
    }
  ],
