{
  "datasets": [
    {
      "name": "6291f5ed",
      "displayName": "Customer_most_spent",
      "queryLines": [
        "SELECT customer_id, SUM(total_spent) AS sum_total_spent\r\n",
        "FROM catalog_tr.golden.customer_summary\r\n",
        "GROUP BY customer_id\r\n",
        "ORDER BY sum_total_spent DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "d92f5679",
      "displayName": "transactions_by_payment_method",
      "queryLines": [
        "SELECT store_location, payment_method, transactions\r\n",
        "FROM catalog_tr.golden.payment_method_by_store\r\n",
        "ORDER BY store_location, transactions DESC;"
      ]
    },
    {
      "name": "22e788b5",
      "displayName": "top_products_sold",
      "queryLines": [
        "SELECT product_id, product_name, units_sold\r\n",
        "FROM catalog_tr.golden.product_performance\r\n",
        "ORDER BY transactions DESC\r\n",
        "LIMIT 5;"
      ]
    }
  ],
